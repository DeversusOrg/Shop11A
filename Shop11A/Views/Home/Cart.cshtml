@model Shop11A.Models.Cart

<h2>Your Shopping Cart</h2>

<div class="container">
    @if (Model.Items.Any())
    {
        foreach (var item in Model.Items)
        {
            <div class="row mb-3">
                <div class="col-md-4">
                    <img src="@item.ImageUrl" alt="@item.Name" style="max-width: 100px;" />
                </div>
                <div class="col-md-8">
                    <h4>@item.Name</h4>
                    <p>@item.Description</p>
                    <p>Price: @item.Price BGN</p>
                </div>
            </div>
        }
        <div class="row">
            <div class="col-md-12">
                <h3>Total: @Model.TotalAmount BGN</h3>
                <h4>Remaining Balance: @Model.RemainingBalance BGN</h4>
                <a asp-action="Checkout" class="btn btn-success">Checkout</a>
            </div>
        </div>
    }
    else
    {
        <p>Your cart is empty</p>
    }
</div>
